#cloud-config
hostname: content-factory
fqdn: content-factory.content-factory-vps.win
manage_etc_hosts: true
disable_root: false
ssh_pwauth: true
users:
  - name: root
    lock_passwd: false
    hashed_passwd: '__ROOT_PASSWORD_HASH__'
chpasswd:
  expire: false
growpart:
  mode: auto
  devices: ['/']
resize_rootfs: true
package_update: true
packages:
  - qemu-guest-agent
write_files:
  - path: /etc/ssh/sshd_config.d/99-root-password.conf
    owner: root:root
    permissions: '0644'
    content: |
      PermitRootLogin yes
      PasswordAuthentication yes
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
  - [sh, -c, "rm -f /etc/ssh/ssh_host_*"]
  - [ssh-keygen, -A]
  - [systemctl, enable, --now, ssh]
